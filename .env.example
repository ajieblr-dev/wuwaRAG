# ========================================================
# Wuthering Waves Lore RAG System Configuration
# ========================================================

# Server Configuration
PORT=8080

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wuwa_lore
VECTOR_DIM=384

# LiteLLM Proxy Gateway
LITELLM_URL=http://localhost:4000
LITELLM_KEY=sk-wuwa-rag-secret
LITELLM_MODEL=wuwa-lore-model
LITELLM_MASTER_KEY=sk-wuwa-rag-secret

# LLM Providers (for LiteLLM routing & fallback)
# Primary: Google Gemini API (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: Groq API (Get from: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace API Token (for sentence-transformers/all-MiniLM-L6-v2)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BASE_URL=https://router.huggingface.co/hf-inference/models

# MediaWiki Wiki Source
WIKI_API_URL=https://wutheringwaves.fandom.com/api.php
DEFAULT_WIKI_PAGE=Simulacrum_of_the_Heart

# RAG Search Settings
TOP_K=5
SCORE_THRESHOLD=0.25

# Database & Authentication
DB_PATH=./data/wuwa.db
JWT_SECRET=replace-with-a-secure-random-secret-key-32chars
DEFAULT_QUESTION_LIMIT=5
